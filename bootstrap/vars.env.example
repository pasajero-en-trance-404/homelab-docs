# Homelab bootstrap configuration
# Copy this file to vars.env and adjust values for your environment.
# vars.env is gitignored (contains environment-specific settings).

# --- System ---
TARGET_USER="administrador"
TARGET_HOME="/home/administrador"
DATA_ROOT="/home/administrador/homelab-data"
REPO_DIR="/home/administrador/homelab-docs"
HOSTNAME="debian-server"

# --- Network ---
# Docker network used by all services
HOMELAB_NETWORK="homelab"
HOMELAB_SUBNET="172.22.0.0/16"
# LAN subnet allowed to reach Homepage dashboard (firewall)
LAN_SUBNET="192.168.1.0/24"

# --- Tailscale ---
# Optional ephemeral auth key. If empty, tailscale up runs interactively.
# Create one at: https://login.tailscale.com/admin/settings/keys
TS_AUTH_KEY=""
# Hostname registered in the tailnet
TS_HOSTNAME="debian-server"
# Re-enable Funnel for the API after bootstrap (true/false)
TS_FUNNEL="true"
# Local port the API is published on (must match compose/api)
API_PORT="8000"

# --- Secrets (GPG vault) ---
# Path to the GPG vault within the repo
SECRETS_DIR="${REPO_DIR}/secrets"
# GPG key ID used to encrypt the vault (gpg --list-secret-keys)
GPG_RECIPIENT=""
