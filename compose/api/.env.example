# REQUIRED. The API refuses to start if this is missing, empty, or whitespace.
# Generate your own key and NEVER commit it to git:
#   openssl rand -hex 32
API_KEY=replace-with-openssl-rand-hex-32

# Internal read-only Docker socket proxy endpoint (not a secret, no host port).
DOCKER_PROXY_URL=http://socket-proxy:2375

# Required numeric group ID from: stat -c %g /var/run/docker.sock
DOCKER_GID=

TZ=America/Argentina/Buenos_Aires
