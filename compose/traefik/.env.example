# Required: IPv4 address reserved for Debian on the LAN.
# Leave blank until the active interface and router DHCP reservation are verified.
LAN_BIND_IP=

# Host directory containing only the Traefik server certificate and private key.
# Keep it outside Git; create it with mode 0700 and protect server.key as 0600.
TLS_CERT_DIR=/home/administrador/homelab-data/traefik/certs
